// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// ─────────────────────────────────────────────────────────────────────────────
// ERP Schema — generated from DBML model
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Catalog / lookup ─────────────────────────────────────────────────────────

model Gender {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.Char(1)
  name      String   @db.VarChar(50)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  products Product[]

  @@index([active])
  @@map("gender")
}

model Category {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.Char(2)
  name      String   @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  products          Product[]
  equivalenceTables EquivalenceTable[]

  @@index([active])
  @@map("category")
}

// ─── Third parties (base for customers & suppliers) ──────────────────────────

/// Tipo de retenedor ante la DIAN — informativo, no dispara cálculo (fase 2: facturación electrónica).
enum WithholdingAgentType {
  ninguno
  gran_contribuyente
  autorretenedor_renta
  agente_retencion_iva
}

/// Régimen de tributación del tercero — informativo, no dispara cálculo de IVA (fase 2).
enum TaxRegime {
  ordinario
  rst
  no_aplica
}

model ThirdParty {
  id                   String                @id @default(uuid(7)) @db.Uuid
  name                 String
  email                String?               @unique
  phone                String?
  address              String?
  isActive             Boolean               @default(true) @map("is_active")
  isSeller             Boolean               @default(false) @map("is_seller")
  isCustomer           Boolean               @default(false) @map("is_customer")
  isSupplier           Boolean               @default(false) @map("is_supplier")
  personType           String                @map("person_type") @db.VarChar(10)
  documentType         String                @map("document_type") @db.VarChar(20)
  documentNumber       String                @unique @map("document_number") @db.VarChar(50)
  firstName            String?               @map("first_name") @db.VarChar(100)
  lastName             String?               @map("last_name") @db.VarChar(100)
  ivaResponsible       Boolean?              @map("iva_responsible")
  withholdingAgentType WithholdingAgentType? @map("withholding_agent_type")
  taxRegime            TaxRegime?            @map("tax_regime")
  deletedAt            DateTime?             @map("deleted_at") @db.Timestamptz
  deletedById          String?               @map("deleted_by_id") @db.Uuid
  createdAt            DateTime?             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime?             @updatedAt @map("updated_at") @db.Timestamptz

  customer           Customer?
  supplier           Supplier?
  documents          Document[]
  sellerDocuments    Document[]           @relation("DocumentSeller")
  soldToCustomers    Customer[]           @relation("SellerThirdParty")
  accountsReceivable AccountsReceivable[] @relation("SellerAR")
  equivalenceTables  EquivalenceTable[]
  deletedBy          User?                @relation("ThirdPartyDeletedBy", fields: [deletedById], references: [id])

  @@index([isActive])
  @@index([isCustomer])
  @@index([isSupplier])
  @@index([isSeller])
  @@index([createdAt])
  @@map("third_parties")
}

// ─── Customer ─────────────────────────────────────────────────────────────────

model Customer {
  id          String   @id @db.Uuid
  sellerId    String?  @map("seller_id") @db.Uuid
  creditLimit Decimal? @map("credit_limit") @db.Decimal(14, 2)
  discount    Decimal? @db.Decimal(5, 2)

  thirdParty         ThirdParty           @relation(fields: [id], references: [id])
  seller             ThirdParty?          @relation("SellerThirdParty", fields: [sellerId], references: [id])
  accountsReceivable AccountsReceivable[]
  customerCredits    CustomerCredit[]
  recibosCaja        ReciboCaja[]

  @@map("customers")
}

// ─── Supplier ─────────────────────────────────────────────────────────────────

model Supplier {
  id             String  @id @db.Uuid
  internalNumber Int     @unique @map("internal_number")
  /// Condiciones de descuento del proveedor, texto libre informativo — no se usa en ningún cálculo.
  discountNotes  String? @map("discount_notes") @db.VarChar(500)

  thirdParty      ThirdParty        @relation(fields: [id], references: [id])
  brands          Brand[]
  accountsPayable AccountsPayable[]
  supplierCredits SupplierCredit[]
  egresos         Egreso[]

  @@map("suppliers")
}

// ─── Brand ────────────────────────────────────────────────────────────────────

model Brand {
  id         String   @id @default(uuid(7)) @db.Uuid
  name       String   @db.VarChar(100)
  active     Boolean  @default(true)
  supplierId String   @map("supplier_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  supplier Supplier  @relation(fields: [supplierId], references: [id])
  products Product[]

  @@index([active])
  @@index([supplierId])
  @@map("brand")
}

// ─── Product ──────────────────────────────────────────────────────────────────

enum UnitOfMeasure {
  unidad
  docena
}

model Product {
  id            String        @id @default(uuid(7)) @db.Uuid
  code          String        @unique @db.VarChar(15)
  legacyCode    String?       @map("legacy_code") @db.VarChar(15)
  description   String        @db.VarChar(300)
  brandId       String        @map("brand_id") @db.Uuid
  genderId      String        @map("gender_id") @db.Uuid
  categoryId    String        @map("category_id") @db.Uuid
  salePrice     Int           @map("sale_price")
  minSalePrice  Int           @map("min_sale_price")
  active        Boolean       @default(true)
  avgCost       Decimal       @default(0) @map("avg_cost") @db.Decimal(14, 4)
  lastCost      Decimal       @default(0) @map("last_cost") @db.Decimal(14, 4)
  unitOfMeasure UnitOfMeasure @default(unidad) @map("unit_of_measure")
  deletedAt     DateTime?     @map("deleted_at") @db.Timestamptz
  deletedById   String?       @map("deleted_by_id") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  brand     Brand    @relation(fields: [brandId], references: [id])
  gender    Gender   @relation(fields: [genderId], references: [id])
  category  Category @relation(fields: [categoryId], references: [id])
  deletedBy User?    @relation("ProductDeletedBy", fields: [deletedById], references: [id])

  documentItems      DocumentItem[]
  inventoryRecords   Inventory[]
  inventoryMovements InventoryMovement[]
  inventorySnapshots InventorySnapshot[]
  binStocks          BinStock[]

  @@index([brandId])
  @@index([genderId])
  @@index([categoryId])
  @@index([createdAt])
  // GET /products siempre filtra por `active` y ordena por createdAt desc: el índice ya viene ordenado para el LIMIT.
  @@index([active, createdAt])
  @@index([active, brandId, createdAt])
  @@index([active, categoryId, createdAt])
  @@index([active, genderId, createdAt])
  // DRIFT ACEPTADO: product_code_trgm_idx / product_legacy_code_trgm_idx (GIN trigram) existen en la DB pero no en este schema — ver "Migration workaround" en backend/CLAUDE.md antes de armar una migración nueva.
  @@map("product")
}

// ─── Equivalence table ────────────────────────────────────────────────────────

model EquivalenceTable {
  id             String   @id @default(uuid(7)) @db.Uuid
  supplierId     String   @map("supplier_id") @db.Uuid
  categoryId     String   @map("category_id") @db.Uuid
  equivalentCode String   @map("equivalent_code") @db.VarChar(100)
  cost           String   @db.VarChar(5)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  supplier ThirdParty @relation(fields: [supplierId], references: [id])
  category Category   @relation(fields: [categoryId], references: [id])

  @@map("equivalence_table")
}

// ─── Warehouse / location ─────────────────────────────────────────────────────

enum WarehouseType {
  store
  warehouse
}

model Warehouse {
  id        String        @id @default(uuid(7)) @db.Uuid
  name      String        @db.VarChar(100)
  type      WarehouseType
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz

  zones              Zone[]
  inventoryRecords   Inventory[]
  inventoryMovements InventoryMovement[]
  inventorySnapshots InventorySnapshot[]
  binStocks          BinStock[]
  documents          Document[]          @relation("DocumentWarehouse")
  destDocuments      Document[]          @relation("DocumentDestWarehouse")

  @@map("warehouse")
}

model Zone {
  id          String   @id @default(uuid(7)) @db.Uuid
  warehouseId String   @map("warehouse_id") @db.Uuid
  name        String   @db.VarChar(100)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  bins      Bin[]

  @@unique([warehouseId, name])
  @@map("zone")
}

model Bin {
  id        String   @id @default(uuid(7)) @db.Uuid
  zoneId    String   @map("zone_id") @db.Uuid
  code      Int      @db.Integer()
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  zone               Zone                @relation(fields: [zoneId], references: [id])
  binStocks          BinStock[]
  inventoryMovements InventoryMovement[]
  inventorySnapshots InventorySnapshot[]
  destDocuments      Document[]          @relation("DocumentDestBin")
  sourceDocuments    Document[]          @relation("DocumentSourceBin")

  @@unique([zoneId, code])
  @@map("bin")
}

// ─── Inventory ────────────────────────────────────────────────────────────────

model Inventory {
  productId   String @map("product_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  quantity    Int    @default(0)

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@id([productId, warehouseId])
  @@map("inventory")
}

model BinStock {
  productId   String @map("product_id") @db.Uuid
  binId       String @map("bin_id") @db.Uuid
  warehouseId String @map("warehouse_id") @db.Uuid
  quantity    Int    @default(0)

  product   Product   @relation(fields: [productId], references: [id])
  bin       Bin       @relation(fields: [binId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@id([productId, binId])
  @@index([binId])
  @@index([warehouseId, productId])
  @@map("bin_stock")
}

enum MovementType {
  purchase
  sale
  return
  transfer
  adjustment
  initial_stock
  void
  production
}

model InventoryMovement {
  id             String       @id @default(uuid(7)) @db.Uuid
  productId      String       @map("product_id") @db.Uuid
  warehouseId    String       @map("warehouse_id") @db.Uuid
  binId          String?      @map("bin_id") @db.Uuid
  movementType   MovementType @map("movement_type")
  /// positive or negative
  quantity       Int
  unitCost       Decimal      @default(0) @map("unit_cost") @db.Decimal(14, 4)
  previousStock  Int?         @map("previous_stock")
  newStock       Int?         @map("new_stock")
  documentId     String?      @map("document_id") @db.Uuid
  documentItemId String?      @map("document_item_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  product      Product       @relation(fields: [productId], references: [id])
  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  bin          Bin?          @relation(fields: [binId], references: [id])
  document     Document?     @relation(fields: [documentId], references: [id])
  documentItem DocumentItem? @relation(fields: [documentItemId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([productId, createdAt])
  @@index([warehouseId])
  @@index([documentId])
  @@index([createdAt])
  @@index([movementType])
  @@map("inventory_movements")
}

model InventorySnapshot {
  snapshotDate DateTime @map("snapshot_date") @db.Date
  /// daily | weekly | monthly
  periodType   String   @default("daily") @map("period_type") @db.VarChar(10)
  productId    String   @map("product_id") @db.Uuid
  warehouseId  String   @map("warehouse_id") @db.Uuid
  binId        String?  @map("bin_id") @db.Uuid
  quantity     Int

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  bin       Bin?      @relation(fields: [binId], references: [id])

  @@id([snapshotDate, periodType, productId, warehouseId])
  @@map("inventory_snapshot")
}

// ─── Users / roles / permissions ─────────────────────────────────────────────

model Permission {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique @db.VarChar(100)
  module    String   @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]

  @@map("permission")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique @db.VarChar(50)
  description String?  @db.VarChar(200)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("role")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @db.VarChar(150)
  username  String   @unique @db.VarChar(150)
  password  String   @db.VarChar(255)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  userRoles                UserRole[]
  documents                Document[]
  confirmedDocuments       Document[]           @relation("DocumentConfirmedBy")
  voidedDocuments          Document[]           @relation("DocumentVoidedBy")
  documentsUpdated         Document[]           @relation("DocumentUpdatedBy")
  documentsConverted       Document[]           @relation("DocumentConvertedBy")
  inventoryMovements       InventoryMovement[]
  deletedProducts          Product[]            @relation("ProductDeletedBy")
  deletedThirdParties      ThirdParty[]         @relation("ThirdPartyDeletedBy")
  reservationReleases      ReservationRelease[]
  systemConfigsActivated   SystemConfig[]       @relation("SystemConfigActivatedBy")
  systemConfigsDeactivated SystemConfig[]       @relation("SystemConfigDeactivatedBy")
  egresos                  Egreso[]
  recibosCaja              ReciboCaja[]

  @@map("user")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_role")
}

// ─── Documents ────────────────────────────────────────────────────────────────

enum DocumentType {
  CM // Compra — entrada inventario + CxP
  DVC // Devolución en compra — salida inventario + reduce CxP
  RMDVC // Remisión dev. compra — temporal, sin efecto inventario
  PE // Pedido — temporal, se convierte en CM
  EAI // Entrada ajuste inventario
  SAJ // Salida ajuste inventario
  COT // Venta a crédito — salida inventario + CxC
  POS // Venta de contado — salida inventario
  REM // Remisión — temporal, se convierte en COT/POS
  DVV // Devolución en venta — entrada inventario + saldo a favor
  T // Traslado entre bodegas
  PV // Preventa — reserva lógica de inventario, sin movimiento físico
}

enum DocumentStatus {
  draft
  confirmed
  voided
}

enum PaymentMethod {
  efectivo
  tarjeta
  transferencia
}

/// Motivo del ajuste (obligatorio solo para EAI): negativo/inventario_general son el mismo caso (stock físico > sistema), separados solo para reportería; traspaso_costo mueve costo de otro producto; otro requiere adjustmentReasonOther.
enum EaiAdjustmentReason {
  negativo
  inventario_general
  traspaso_costo
  otro
}

/// Modalidad de una DVV (obligatoria): saldo_a_favor/cambio_producto generan saldo a favor del cliente; devolucion_dinero solo entra inventario (reembolso manual).
enum DvvRefundMethod {
  saldo_a_favor
  cambio_producto
  devolucion_dinero
}

model Document {
  id                    String               @id @default(uuid(7)) @db.Uuid
  type                  DocumentType
  number                String               @db.VarChar(30)
  date                  DateTime             @db.Date
  thirdPartyId          String?              @map("third_party_id") @db.Uuid
  /// Vendedor asignado — solo preventas (PV); ThirdParty con isSeller=true
  sellerId              String?              @map("seller_id") @db.Uuid
  userId                String               @map("user_id") @db.Uuid
  status                DocumentStatus       @default(draft)
  total                 Decimal              @default(0) @db.Decimal(16, 2)
  notes                 String?
  /// Motivo del ajuste — solo EAI, obligatorio para ese tipo
  adjustmentReason      EaiAdjustmentReason? @map("adjustment_reason")
  /// Detalle libre — obligatorio solo cuando adjustmentReason = otro
  adjustmentReasonOther String?              @map("adjustment_reason_other") @db.VarChar(300)
  /// Forma de pago — solo POS por ahora; informativo, sin lógica de caja.
  paymentMethod         PaymentMethod?       @map("payment_method")
  /// Modalidad de devolución — solo DVV, obligatoria para ese tipo
  refundMethod          DvvRefundMethod?     @map("refund_method")
  /// Bodega principal: destino en CM/EAI, origen en DVC/SAJ/T
  warehouseId           String?              @map("warehouse_id") @db.Uuid
  /// Bodega destino — solo traslados (T)
  destWarehouseId       String?              @map("dest_warehouse_id") @db.Uuid
  /// Bin origen — solo traslados desde bodega de almacenamiento
  sourceBinId           String?              @map("source_bin_id") @db.Uuid
  /// Bin destino — solo traslados hacia bodega de almacenamiento
  destBinId             String?              @map("dest_bin_id") @db.Uuid
  sourceDocumentId      String?              @map("source_document_id") @db.Uuid
  /// Quién confirmó — null mientras el documento sigue en borrador
  confirmedById         String?              @map("confirmed_by_id") @db.Uuid
  /// Quién anuló — null si nunca fue anulado
  voidedById            String?              @map("voided_by_id") @db.Uuid
  /// Quién editó por última vez el borrador — null si nunca se editó tras crear
  updatedById           String?              @map("updated_by_id") @db.Uuid
  /// Quién convirtió el documento a una venta (solo preventas y remisiones) — null si no se convirtió
  convertedById         String?              @map("converted_by_id") @db.Uuid
  convertedAt           DateTime?            @map("converted_at") @db.Timestamptz
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz

  thirdParty       ThirdParty? @relation(fields: [thirdPartyId], references: [id])
  seller           ThirdParty? @relation("DocumentSeller", fields: [sellerId], references: [id])
  user             User        @relation(fields: [userId], references: [id])
  confirmedBy      User?       @relation("DocumentConfirmedBy", fields: [confirmedById], references: [id])
  voidedBy         User?       @relation("DocumentVoidedBy", fields: [voidedById], references: [id])
  updatedBy        User?       @relation("DocumentUpdatedBy", fields: [updatedById], references: [id])
  convertedBy      User?       @relation("DocumentConvertedBy", fields: [convertedById], references: [id])
  warehouse        Warehouse?  @relation("DocumentWarehouse", fields: [warehouseId], references: [id])
  destWarehouse    Warehouse?  @relation("DocumentDestWarehouse", fields: [destWarehouseId], references: [id])
  sourceBin        Bin?        @relation("DocumentSourceBin", fields: [sourceBinId], references: [id])
  destBin          Bin?        @relation("DocumentDestBin", fields: [destBinId], references: [id])
  sourceDocument   Document?   @relation("DocumentSource", fields: [sourceDocumentId], references: [id])
  derivedDocuments Document[]  @relation("DocumentSource")

  documentItems          DocumentItem[]
  inventoryMovements     InventoryMovement[]
  accountsReceivable     AccountsReceivable[]
  accountsPayable        AccountsPayable[]
  supplierCredits        SupplierCredit[]            @relation("DvcSupplierCredit")
  // Créditos a favor del cliente generados por esta DVV
  customerCredits        CustomerCredit[]            @relation("DvvCustomerCredit")
  // Aplicaciones de saldo a favor hechas al confirmar esta venta (POS/COT)
  appliedCustomerCredits CustomerCreditApplication[] @relation("CustomerCreditSaleApplication")

  @@unique([type, number])
  @@index([type, status])
  @@index([date])
  @@index([thirdPartyId])
  // Reverse lookup de derivedDocuments (Prisma no indexa FKs en PostgreSQL);
  // corre en cada fila de la lista de documentos y en cada detalle de PV.
  @@index([sourceDocumentId])
  @@map("document")
}

model DocumentItem {
  id                String   @id @default(uuid(7)) @db.Uuid
  documentId        String   @map("document_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  /// C | F | null
  referenceType     String?  @map("reference_type") @db.Char(1)
  references        String?
  quantity          Int
  unitPrice         Decimal  @default(0) @map("unit_price") @db.Decimal(14, 4)
  unitCost          Decimal  @default(0) @map("unit_cost") @db.Decimal(14, 4)
  subtotal          Decimal  @default(0) @db.Decimal(16, 2)
  observaciones     String?  @db.VarChar(500)
  /// Solo PV: cantidad de la reserva liberada manualmente. La reserva vigente es
  /// derivada (quantity - releasedQuantity - convertedQuantity), nunca un total persistido.
  releasedQuantity  Int      @default(0) @map("released_quantity")
  /// Solo PV: cantidad ya convertida a un documento de venta real.
  convertedQuantity Int      @default(0) @map("converted_quantity")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  document Document @relation(fields: [documentId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])

  inventoryMovements  InventoryMovement[]
  reservationReleases ReservationRelease[]

  @@index([productId])
  // Prisma no crea índices de FK automáticamente en PostgreSQL: sin este, cargar
  // los ítems de un documento (detalle, confirm, void) hacía seq scan de la tabla.
  @@index([documentId])
  @@map("document_item")
}

// ─── Liberación de reservas (preventa) ───────────────────────────────────────

// Bitácora append-only de liberaciones parciales de reserva — nunca se edita ni se borra.
model ReservationRelease {
  id             String   @id @default(uuid(7)) @db.Uuid
  documentItemId String   @map("document_item_id") @db.Uuid
  quantity       Int
  userId         String   @map("user_id") @db.Uuid
  notes          String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  documentItem DocumentItem @relation(fields: [documentItemId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([documentItemId])
  @@map("reservation_release")
}

// ─── Accounts receivable ─────────────────────────────────────────────────────

enum AccountsReceivableStatus {
  pending
  partial
  paid
}

model AccountsReceivable {
  id          String                   @id @default(uuid(7)) @db.Uuid
  clientId    String                   @map("client_id") @db.Uuid
  sellerId    String                   @map("seller_id") @db.Uuid
  documentId  String                   @map("document_id") @db.Uuid
  totalAmount Decimal                  @map("total_amount") @db.Decimal(16, 2)
  /// Abonado acumulado, cacheado para filtrar/ordenar sin agregar en cada consulta. Reforzado por CHECKs a mano. Mismo criterio que AccountsPayable.paidAmount.
  paidAmount  Decimal                  @default(0) @map("paid_amount") @db.Decimal(16, 2)
  dueDate     DateTime?                @map("due_date") @db.Date
  status      AccountsReceivableStatus @default(pending)
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  client   Customer   @relation(fields: [clientId], references: [id])
  seller   ThirdParty @relation("SellerAR", fields: [sellerId], references: [id])
  document Document   @relation(fields: [documentId], references: [id])

  receivablePayments    ReceivablePayment[]
  reciboCajaAllocations ReciboCajaAllocation[]

  @@index([clientId, status])
  @@index([sellerId])
  @@index([documentId])
  @@index([dueDate])
  @@map("accounts_receivable")
}

model ReceivablePayment {
  id                  String   @id @default(uuid(7)) @db.Uuid
  accountReceivableId String   @map("account_receivable_id") @db.Uuid
  amount              Decimal  @db.Decimal(16, 2)
  paymentDate         DateTime @map("payment_date") @db.Date
  paymentMethod       String   @map("payment_method")
  reference           String?
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  accountReceivable AccountsReceivable @relation(fields: [accountReceivableId], references: [id])

  @@index([accountReceivableId])
  @@map("receivable_payments")
}

// ─── Accounts payable ────────────────────────────────────────────────────────

enum AccountsPayableStatus {
  pending
  partial
  paid
}

model AccountsPayable {
  id          String                @id @default(uuid(7)) @db.Uuid
  supplierId  String                @map("supplier_id") @db.Uuid
  documentId  String                @map("document_id") @db.Uuid
  totalAmount Decimal               @map("total_amount") @db.Decimal(16, 2)
  /// Abonado acumulado (efectivo + saldo a favor), cacheado para filtrar/ordenar sin agregar en cada consulta. Reforzado por CHECKs a mano.
  paidAmount  Decimal               @default(0) @map("paid_amount") @db.Decimal(16, 2)
  dueDate     DateTime?             @map("due_date") @db.Date
  status      AccountsPayableStatus @default(pending)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  supplier           Supplier                    @relation(fields: [supplierId], references: [id])
  document           Document                    @relation(fields: [documentId], references: [id])
  payablePayments    PayablePayment[]
  creditApplications SupplierCreditApplication[]
  egresoAllocations  EgresoAllocation[]

  // Pantalla de egreso: CxP abiertas de un proveedor. Prisma no indexa FKs en PostgreSQL.
  @@index([supplierId, status])
  // void() de un documento hace deleteMany({ where: { documentId } }).
  @@index([documentId])
  // Listado global ordenado por vencimiento; en PostgreSQL un índice ASC ya es
  // NULLS LAST, que es justo el orderBy del service.
  @@index([dueDate])
  @@map("accounts_payable")
}

model PayablePayment {
  id               String   @id @default(uuid(7)) @db.Uuid
  accountPayableId String   @map("account_payable_id") @db.Uuid
  amount           Decimal  @db.Decimal(16, 2)
  paymentDate      DateTime @map("payment_date") @db.Date
  paymentMethod    String   @map("payment_method")
  bankDestination  String?  @map("bank_destination")
  reference        String?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  accountPayable AccountsPayable @relation(fields: [accountPayableId], references: [id])

  // Histórico de abonos en el detalle de la CxP. Sin esto es seq scan.
  @@index([accountPayableId])
  @@map("payable_payments")
}

// ─── Supplier credit (saldo a favor de proveedor) ────────────────────────────

model SupplierCredit {
  id               String   @id @default(uuid(7)) @db.Uuid
  supplierId       String   @map("supplier_id") @db.Uuid
  // Monto original de la nota crédito. Se guarda en positivo (a diferencia de la
  // AccountsPayable negativa que este modelo reemplaza) porque es un saldo a favor.
  amount           Decimal  @db.Decimal(16, 2)
  // Invariante: 0 <= balance <= amount; al llegar a 0, status pasa a 'used'. Reforzado por el CHECK "supplier_credit_balance_range_chk" (a mano).
  balance          Decimal  @db.Decimal(16, 2)
  sourceDocumentId String?  @map("source_document_id") @db.Uuid
  /// available | used
  status           String   @default("available") @db.VarChar(10)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  supplier       Supplier                    @relation(fields: [supplierId], references: [id])
  sourceDocument Document?                   @relation("DvcSupplierCredit", fields: [sourceDocumentId], references: [id])
  applications   SupplierCreditApplication[]

  // Una DVC genera exactamente un crédito: bloquea duplicados por doble confirm o retry.
  @@unique([sourceDocumentId])
  // Incluye createdAt para que "créditos disponibles de un proveedor" (WHERE
  // supplierId + status, ORDER BY createdAt) salga ordenada sin nodo Sort.
  @@index([supplierId, status, createdAt])
  @@map("supplier_credit")
}

model SupplierCreditApplication {
  id               String   @id @default(uuid(7)) @db.Uuid
  supplierCreditId String   @map("supplier_credit_id") @db.Uuid
  accountPayableId String   @map("account_payable_id") @db.Uuid
  /// Egreso que aplicó este crédito. Nullable: las aplicaciones anteriores al módulo
  /// de egresos (las hacía POST /accounts-payable/:id/payments, eliminado) no tienen egreso.
  egresoId         String?  @map("egreso_id") @db.Uuid
  // Monto aplicado en este movimiento, en positivo (parte del balance del crédito
  // que se descuenta contra esta cuenta por pagar).
  amount           Decimal  @db.Decimal(16, 2)
  appliedAt        DateTime @default(now()) @map("applied_at") @db.Timestamptz

  supplierCredit SupplierCredit  @relation(fields: [supplierCreditId], references: [id])
  accountPayable AccountsPayable @relation(fields: [accountPayableId], references: [id])
  /// Restrict explícito: el default de Prisma para una FK nullable es SET NULL, que
  /// dejaría la aplicación huérfana si alguna vez se borra un egreso.
  egreso         Egreso?         @relation(fields: [egresoId], references: [id], onDelete: Restrict)

  // Un mismo crédito no se aplica dos veces a la misma cuenta dentro de un egreso. En
  // PostgreSQL varios NULL conviven, así que las filas viejas (sin egreso) no chocan.
  @@unique([egresoId, accountPayableId, supplierCreditId])
  @@index([accountPayableId])
  @@index([supplierCreditId])
  @@map("supplier_credit_application")
}

// ─── Customer credit (saldo a favor del cliente) ─────────────────────────────
// Homólogo de SupplierCredit del lado cliente; no unificados (decisión de arquitectura), solo comparten lógica de servicio.

model CustomerCredit {
  id               String   @id @default(uuid(7)) @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  // Monto original del saldo a favor, en positivo.
  amount           Decimal  @db.Decimal(16, 2)
  // Invariante: 0 <= balance <= amount; llega a 0 → status 'used'. Único CHECK a mano del schema ("customer_credit_balance_range_chk"), red final contra saldo corrupto.
  balance          Decimal  @db.Decimal(16, 2)
  sourceDocumentId String?  @map("source_document_id") @db.Uuid
  /// available | used
  status           String   @default("available") @db.VarChar(10)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  customer       Customer                    @relation(fields: [customerId], references: [id])
  sourceDocument Document?                   @relation("DvvCustomerCredit", fields: [sourceDocumentId], references: [id])
  applications   CustomerCreditApplication[]

  // Una DVV genera un único crédito — bloquea duplicados por doble confirm o retry.
  @@unique([sourceDocumentId])
  // Incluye createdAt para que la consulta de créditos disponibles del cliente
  // (WHERE customerId + status, ORDER BY createdAt) salga ordenada sin nodo Sort.
  @@index([customerId, status, createdAt])
  @@map("customer_credit")
}

model CustomerCreditApplication {
  id               String   @id @default(uuid(7)) @db.Uuid
  customerCreditId String   @map("customer_credit_id") @db.Uuid
  // Ancla a la venta (POS/COT), no a una cuenta — el saldo se aplica al confirmar la venta, y POS no crea cuenta.
  saleDocumentId   String   @map("sale_document_id") @db.Uuid
  amount           Decimal  @db.Decimal(16, 2)
  appliedAt        DateTime @default(now()) @map("applied_at") @db.Timestamptz

  customerCredit CustomerCredit @relation(fields: [customerCreditId], references: [id])
  saleDocument   Document       @relation("CustomerCreditSaleApplication", fields: [saleDocumentId], references: [id])

  // Un mismo crédito no se aplica dos veces a la misma venta; el prefijo cubre
  // el lookup "¿este crédito ya tiene aplicaciones?" al anular la DVV.
  @@unique([customerCreditId, saleDocumentId])
  @@index([saleDocumentId])
  @@map("customer_credit_application")
}

// ─── Consecutivos ─────────────────────────────────────────────────────────────

// Consecutivo atómico: INSERT...ON CONFLICT bloquea la fila hasta el COMMIT, sin huecos por rollback (a diferencia de un SEQUENCE nativo)
model Sequence {
  key       String @id @db.VarChar(30)
  lastValue Int    @default(0) @map("last_value")

  @@map("sequence")
}

// ─── Egreso (documento de tesorería) ─────────────────────────────────────────

/// Forma de pago del egreso — "almacén" vs "oficina" es solo clasificación, el sistema no lleva saldos de caja.
enum EgresoPaymentMethod {
  efectivo_almacen
  consignacion_almacen
  cheque
  efectivo_oficina
  consignacion_oficina
}

/// Paga una o varias CxP de un mismo proveedor en un solo movimiento; no se anula ni se edita.
model Egreso {
  id             String   @id @default(uuid(7)) @db.Uuid
  /// Consecutivo propio (clave "EGRESO" en Sequence), ceros a la izquierda a 6 dígitos para ordenar como texto.
  number         String   @unique @db.VarChar(30)
  /// Sin @default a propósito: la fija el service en huso Colombia, no el de la base (mismo criterio que Document.date).
  date           DateTime @db.Date
  supplierId     String   @map("supplier_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// total = cashTotal + creditTotal (CHECK) y también la suma de EgresoAllocation.amount (eso lo valida el service, ningún CHECK lo ve).
  total          Decimal  @db.Decimal(16, 2)
  cashTotal      Decimal  @map("cash_total") @db.Decimal(16, 2)
  creditTotal    Decimal  @map("credit_total") @db.Decimal(16, 2)
  notes          String?  @db.VarChar(500)
  /// Clave que manda el cliente para que un reintento de red no pague dos veces.
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  supplier           Supplier                    @relation(fields: [supplierId], references: [id])
  user               User                        @relation(fields: [userId], references: [id])
  payments           EgresoPayment[]
  allocations        EgresoAllocation[]
  creditApplications SupplierCreditApplication[]

  @@index([date])
  @@index([supplierId, date])
  @@index([userId])
  @@map("egreso")
}

model EgresoPayment {
  id        String              @id @default(uuid(7)) @db.Uuid
  egresoId  String              @map("egreso_id") @db.Uuid
  method    EgresoPaymentMethod
  amount    Decimal             @db.Decimal(16, 2)
  /// Número de cheque o de consignación. Obligatorio para `cheque` — lo valida el service.
  reference String?             @db.VarChar(100)
  bank      String?             @db.VarChar(100)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz

  egreso Egreso @relation(fields: [egresoId], references: [id])

  @@index([egresoId])
  @@map("egreso_payment")
}

model EgresoAllocation {
  id               String  @id @default(uuid(7)) @db.Uuid
  egresoId         String  @map("egreso_id") @db.Uuid
  accountPayableId String  @map("account_payable_id") @db.Uuid
  /// Total abonado a esta cuenta por pagar en este egreso (efectivo + saldo a favor).
  amount           Decimal @db.Decimal(16, 2)
  /// Parte de `amount` cubierta con saldo a favor, guardada aparte para que el detalle de la CxP la lea sin join. CHECK: 0 <= creditAmount <= amount.
  creditAmount     Decimal @default(0) @map("credit_amount") @db.Decimal(16, 2)

  egreso         Egreso          @relation(fields: [egresoId], references: [id])
  accountPayable AccountsPayable @relation(fields: [accountPayableId], references: [id])

  @@unique([egresoId, accountPayableId])
  @@index([accountPayableId])
  @@map("egreso_allocation")
}

// ─── Recibo de caja (documento de tesorería, lado cliente) ───────────────────

/// Paga una o varias CxC de un mismo cliente en un solo movimiento; no se anula ni se edita. Sin saldo a favor: a diferencia de Egreso, no hay líneas de crédito — regla de negocio explícita.
model ReciboCaja {
  id             String   @id @default(uuid(7)) @db.Uuid
  /// Consecutivo propio (clave "RECIBO_CAJA" en Sequence), ceros a la izquierda a 6 dígitos para ordenar como texto.
  number         String   @unique @db.VarChar(30)
  /// Sin @default a propósito: la fija el service en huso Colombia, no el de la base (mismo criterio que Egreso.date).
  date           DateTime @db.Date
  clientId       String   @map("client_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// total = suma de las formas de pago (CHECK) y también la suma de ReciboCajaAllocation.amount (eso lo valida el service, ningún CHECK lo ve).
  total          Decimal  @db.Decimal(16, 2)
  notes          String?  @db.VarChar(500)
  /// Clave que manda el cliente para que un reintento de red no cobre dos veces.
  idempotencyKey String   @unique @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  client      Customer               @relation(fields: [clientId], references: [id])
  user        User                   @relation(fields: [userId], references: [id])
  payments    ReciboCajaPayment[]
  allocations ReciboCajaAllocation[]

  @@index([date])
  @@index([clientId, date])
  @@index([userId])
  @@map("recibo_caja")
}

model ReciboCajaPayment {
  id           String              @id @default(uuid(7)) @db.Uuid
  reciboCajaId String              @map("recibo_caja_id") @db.Uuid
  /// Mismo enum que Egreso — misma tesorería, mismas formas de pago (regla de negocio explícita).
  method       EgresoPaymentMethod
  amount       Decimal             @db.Decimal(16, 2)
  /// Número de cheque o de consignación. Obligatorio para `cheque` — lo valida el service.
  reference    String?             @db.VarChar(100)
  bank         String?             @db.VarChar(100)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz

  reciboCaja ReciboCaja @relation(fields: [reciboCajaId], references: [id])

  @@index([reciboCajaId])
  @@map("recibo_caja_payment")
}

model ReciboCajaAllocation {
  id                  String  @id @default(uuid(7)) @db.Uuid
  reciboCajaId        String  @map("recibo_caja_id") @db.Uuid
  accountReceivableId String  @map("account_receivable_id") @db.Uuid
  /// Total abonado a esta cuenta por cobrar en este recibo.
  amount              Decimal @db.Decimal(16, 2)

  reciboCaja        ReciboCaja         @relation(fields: [reciboCajaId], references: [id])
  accountReceivable AccountsReceivable @relation(fields: [accountReceivableId], references: [id])

  @@unique([reciboCajaId, accountReceivableId])
  @@index([accountReceivableId])
  @@map("recibo_caja_allocation")
}

// ─── Configuración del sistema ────────────────────────────────────────────────
// Fila única (singleton): modo de solo lectura del cierre contable, cacheado en memoria por SystemConfigService.
model SystemConfig {
  id              String    @id @default(uuid(7)) @db.Uuid
  readOnlyMode    Boolean   @default(false) @map("read_only_mode")
  activatedById   String?   @map("activated_by_id") @db.Uuid
  activatedAt     DateTime? @map("activated_at") @db.Timestamptz
  deactivatedById String?   @map("deactivated_by_id") @db.Uuid
  deactivatedAt   DateTime? @map("deactivated_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  activatedBy   User? @relation("SystemConfigActivatedBy", fields: [activatedById], references: [id])
  deactivatedBy User? @relation("SystemConfigDeactivatedBy", fields: [deactivatedById], references: [id])

  @@map("system_config")
}
